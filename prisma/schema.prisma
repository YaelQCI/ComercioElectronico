// Modelo físico del issue #33. SQL adicional en la migración inicial.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  GUEST_ORDER_ACCESS
}

enum FacetKind {
  GOAL
  DISCIPLINE
}

enum MediaKind {
  FRONT
  NUTRITION
  GALLERY
}

enum ProductRelationKind {
  RELATED
  CROSS_SELL
}

enum ExpiryPrecision {
  DAY
  MONTH
}

enum InventoryMovementKind {
  RECEIPT
  RESERVE
  RELEASE
  SALE
  ADJUSTMENT
  WASTE
  RETURN_SELLABLE
  RETURN_NON_SELLABLE
}

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
  ABANDONED
}

enum CartItemState {
  ACTIVE
  SAVED
}

enum QuoteStatus {
  AVAILABLE
  ACCEPTED
  EXPIRED
  INVALIDATED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
}

enum MoneyStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  NOT_REQUIRED
  RECONCILING
}

enum OrderLineKind {
  VARIANT
  BUNDLE
}

enum ReservationState {
  ACTIVE
  RECONCILING
  CONSUMED
  RELEASED
}

enum CouponKind {
  FIXED
  PERCENTAGE
}

enum CouponScope {
  CATALOG
  PRODUCTS
  CATEGORIES
}

enum ResourceState {
  RESERVED
  CONSUMED
  RELEASED
}

enum LoyaltyEntryKind {
  EARN
  REDEEM
  RESTORE
  REVERSE
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  SESSION_CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
  RECONCILING
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum RefundKind {
  CANCELLATION
  RETURN
  PRICE_MATCH
  COMPENSATION
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SETTLED
  FAILED
  REQUIRES_REVIEW
}

enum RefundAllocationKind {
  UNIT
  SHIPPING
}

enum ReturnReason {
  VOLUNTARY
  DAMAGED_ON_RECEIPT
  BROKEN_SEAL
  WRONG_LOT
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  RESOLVED
}

enum ReturnCostPayer {
  CUSTOMER
  STORE
}

enum ReturnItemState {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  RESOLVED
}

enum ProductCondition {
  SEALED
  OPENED
  DAMAGED
  EXPIRED
  WRONG_LOT
  UNVERIFIABLE
}

enum ReturnDisposition {
  SELLABLE
  NON_SELLABLE
  QUARANTINE
}

enum PriceMatchStatus {
  REQUESTED
  APPROVED
  REJECTED
  RESOLVED
}

enum ReviewModerationAction {
  HIDE
  RESTORE
}

enum RestockState {
  ACTIVE
  PROCESSING
  NOTIFIED
  CANCELED
}

enum OutboxKind {
  EMAIL
  CREATE_PAYMENT
  REFUND
  RECONCILE_PAYMENT
  RESTOCK_NOTICE
}

enum OutboxState {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model User {
  id                                String                @id @default(uuid()) @db.Uuid
  email                             String
  emailNormalized                   String                @unique
  passwordHash                      String
  displayName                       String
  themePreference                   String                @default("system")
  phone                             String?
  role                              UserRole              @default(CUSTOMER)
  emailVerifiedAt                   DateTime?             @db.Timestamptz(3)
  authVersion                       Int                   @default(0)
  deletedAt                         DateTime?             @db.Timestamptz(3)
  createdAt                         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                         DateTime              @updatedAt @db.Timestamptz(3)
  authSession_user                  AuthSession[]         @relation("AuthSession_userId")
  actionToken_user                  ActionToken[]         @relation("ActionToken_userId")
  address_user                      Address[]             @relation("Address_userId")
  mediaAsset_createdBy              MediaAsset[]          @relation("MediaAsset_createdById")
  inventoryMovement_actor           InventoryMovement[]   @relation("InventoryMovement_actorId")
  cart_user                         Cart[]                @relation("Cart_userId")
  order_user                        Order[]               @relation("Order_userId")
  orderStatusHistory_actor          OrderStatusHistory[]  @relation("OrderStatusHistory_actorId")
  couponUsage_user                  CouponUsage[]         @relation("CouponUsage_userId")
  loyaltyAccount_user               LoyaltyAccount?       @relation("LoyaltyAccount_userId")
  loyaltyLedgerEntry_actor          LoyaltyLedgerEntry[]  @relation("LoyaltyLedgerEntry_actorId")
  pointReservation_user             PointReservation[]    @relation("PointReservation_userId")
  returnRequest_requestedByUser     ReturnRequest[]       @relation("ReturnRequest_requestedByUserId")
  returnRequest_reviewedBy          ReturnRequest[]       @relation("ReturnRequest_reviewedById")
  returnInspection_inspectedBy      ReturnInspection[]    @relation("ReturnInspection_inspectedById")
  priceMatchRequest_requestedByUser PriceMatchRequest[]   @relation("PriceMatchRequest_requestedByUserId")
  priceMatchRequest_reviewedBy      PriceMatchRequest[]   @relation("PriceMatchRequest_reviewedById")
  review_user                       Review[]              @relation("Review_userId")
  reviewModeration_admin            ReviewModeration[]    @relation("ReviewModeration_adminId")
  restockSubscription_user          RestockSubscription[] @relation("RestockSubscription_userId")
  auditEvent_actor                  AuditEvent[]          @relation("AuditEvent_actorId")
  storeSettings_updatedBy           StoreSettings[]       @relation("StoreSettings_updatedById")
  contentPage_updatedBy             ContentPage[]         @relation("ContentPage_updatedById")
}

// Contadores compartidos por todas las instancias; claves SHA-256, nunca IP/correo.
model RequestLimit {
  keyHash   String   @id @db.Char(64)
  hits      Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model AuthSession {
  id                        String              @id @default(uuid()) @db.Uuid
  userId                    String              @db.Uuid
  tokenFamilyId             String              @unique @db.Uuid
  absoluteExpiresAt         DateTime            @db.Timestamptz(3)
  lastUsedAt                DateTime            @default(now()) @db.Timestamptz(3)
  revokedAt                 DateTime?           @db.Timestamptz(3)
  revocationReason          String?
  createdAt                 DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @db.Timestamptz(3)
  user                      User                @relation("AuthSession_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refreshCredential_session RefreshCredential[] @relation("RefreshCredential_sessionId")

  @@index([userId, revokedAt, absoluteExpiresAt])
}

model RefreshCredential {
  id                           String             @id @default(uuid()) @db.Uuid
  sessionId                    String             @db.Uuid
  tokenHash                    String             @unique
  expiresAt                    DateTime           @db.Timestamptz(3)
  consumedAt                   DateTime?          @db.Timestamptz(3)
  revokedAt                    DateTime?          @db.Timestamptz(3)
  replacedById                 String?            @unique @db.Uuid
  createdAt                    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime           @updatedAt @db.Timestamptz(3)
  session                      AuthSession        @relation("RefreshCredential_sessionId", fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacedBy                   RefreshCredential? @relation("RefreshCredential_replacedById", fields: [replacedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refreshCredential_replacedBy RefreshCredential? @relation("RefreshCredential_replacedById")

  @@index([sessionId])
}

model ActionToken {
  id                           String              @id @default(uuid()) @db.Uuid
  purpose                      TokenPurpose
  tokenHash                    String              @unique
  emailNormalized              String
  userId                       String?             @db.Uuid
  orderId                      String?             @db.Uuid
  expiresAt                    DateTime            @db.Timestamptz(3)
  consumedAt                   DateTime?           @db.Timestamptz(3)
  attemptCount                 Int                 @default(0)
  createdAt                    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime            @updatedAt @db.Timestamptz(3)
  user                         User?               @relation("ActionToken_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order                        Order?              @relation("ActionToken_orderId", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  returnRequest_guestProof     ReturnRequest[]     @relation("ReturnRequest_guestProofId")
  priceMatchRequest_guestProof PriceMatchRequest[] @relation("PriceMatchRequest_guestProofId")

  @@unique([id, orderId])
  @@index([purpose, expiresAt, consumedAt])
}

model Address {
  id                         String         @id @default(uuid()) @db.Uuid
  userId                     String         @db.Uuid
  label                      String?
  recipientName              String
  phone                      String
  countryCode                String         @default("MX") @db.Char(2)
  postalCode                 String         @db.VarChar(5)
  state                      String
  city                       String
  district                   String
  street                     String
  exteriorNumber             String
  interiorNumber             String?
  references                 String?
  isDefault                  Boolean        @default(false)
  createdAt                  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime       @updatedAt @db.Timestamptz(3)
  user                       User           @relation("Address_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderAddress_sourceAddress OrderAddress[] @relation("OrderAddress_sourceAddressId")

  @@index([userId])
}

model Brand {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  slug          String    @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  product_brand Product[] @relation("Product_brandId")
}

model Category {
  id                       String            @id @default(uuid()) @db.Uuid
  parentId                 String?           @db.Uuid
  name                     String
  slug                     String            @unique
  position                 Int               @default(0)
  isActive                 Boolean           @default(true)
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)
  parent                   Category?         @relation("Category_parentId", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category_parent          Category[]        @relation("Category_parentId")
  productCategory_category ProductCategory[] @relation("ProductCategory_categoryId")
  couponCategory_category  CouponCategory[]  @relation("CouponCategory_categoryId")

  @@index([parentId, position])
}

model Product {
  id                            String            @id @default(uuid()) @db.Uuid
  brandId                       String?           @db.Uuid
  name                          String
  slug                          String            @unique
  description                   String
  usageInstructions             String?
  ingredients                   String?
  allergenInformation           String?
  featuredPosition              Int?
  publishedAt                   DateTime?         @db.Timestamptz(3)
  deletedAt                     DateTime?         @db.Timestamptz(3)
  createdAt                     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime          @updatedAt @db.Timestamptz(3)
  brand                         Brand?            @relation("Product_brandId", fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productCategory_product       ProductCategory[] @relation("ProductCategory_productId")
  productFacet_product          ProductFacet[]    @relation("ProductFacet_productId")
  productVariant_product        ProductVariant[]  @relation("ProductVariant_productId")
  productMedia_product          ProductMedia[]    @relation("ProductMedia_productId")
  productRelation_sourceProduct ProductRelation[] @relation("ProductRelation_sourceProductId")
  productRelation_targetProduct ProductRelation[] @relation("ProductRelation_targetProductId")
  couponProduct_product         CouponProduct[]   @relation("CouponProduct_productId")
  review_product                Review[]          @relation("Review_productId")

  @@index([brandId])
  @@index([deletedAt, publishedAt])
}

model ProductCategory {
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  isPrimary  Boolean  @default(false)
  product    Product  @relation("ProductCategory_productId", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category   Category @relation("ProductCategory_categoryId", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Facet {
  id                 String         @id @default(uuid()) @db.Uuid
  kind               FacetKind
  name               String
  slug               String
  position           Int            @default(0)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
  productFacet_facet ProductFacet[] @relation("ProductFacet_facetId")

  @@unique([kind, slug])
}

model ProductFacet {
  productId String  @db.Uuid
  facetId   String  @db.Uuid
  product   Product @relation("ProductFacet_productId", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  facet     Facet   @relation("ProductFacet_facetId", fields: [facetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([productId, facetId])
  @@index([facetId])
}

model ProductVariant {
  id                          String                @id @default(uuid()) @db.Uuid
  productId                   String                @db.Uuid
  sku                         String                @unique
  flavor                      String
  flavorNormalized            String
  presentationLabel           String
  presentationNormalized      String
  contentAmount               Decimal               @db.Decimal(14, 4)
  contentUnit                 String
  servings                    Decimal?              @db.Decimal(14, 4)
  servingAmount               Decimal?              @db.Decimal(14, 4)
  servingUnit                 String?
  nutritionData               Json?
  ingredientsOverride         String?
  priceCents                  BigInt
  compareAtPriceCents         BigInt?
  priceVersion                Int                   @default(1)
  weightGrams                 Int
  lengthMm                    Int
  widthMm                     Int
  heightMm                    Int
  deletedAt                   DateTime?             @db.Timestamptz(3)
  createdAt                   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime              @updatedAt @db.Timestamptz(3)
  product                     Product               @relation("ProductVariant_productId", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productMedia_variant        ProductMedia[]        @relation("ProductMedia_variantId")
  bundleComponent_variant     BundleComponent[]     @relation("BundleComponent_variantId")
  inventoryLot_variant        InventoryLot[]        @relation("InventoryLot_variantId")
  cartItem_variant            CartItem[]            @relation("CartItem_variantId")
  orderLine_variant           OrderLine[]           @relation("OrderLine_variantId")
  orderComponent_variant      OrderComponent[]      @relation("OrderComponent_variantId")
  orderUnit_variant           OrderUnit[]           @relation("OrderUnit_variantId")
  restockSubscription_variant RestockSubscription[] @relation("RestockSubscription_variantId")
  availabilityObservation     VariantAvailability?

  @@unique([productId, flavorNormalized, presentationNormalized])
  @@unique([id, productId])
  @@index([productId, priceCents])
}

model MediaAsset {
  id                            String          @id @default(uuid()) @db.Uuid
  storageKey                    String          @unique
  mimeType                      String
  byteSize                      BigInt
  checksum                      String
  originalName                  String?
  createdById                   String?         @db.Uuid
  createdAt                     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime        @updatedAt @db.Timestamptz(3)
  createdBy                     User?           @relation("MediaAsset_createdById", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productMedia_asset            ProductMedia[]  @relation("ProductMedia_assetId")
  bundle_imageAsset             Bundle[]        @relation("Bundle_imageAssetId")
  inventoryLot_certificateAsset InventoryLot[]  @relation("InventoryLot_certificateAssetId")
  claimEvidence_asset           ClaimEvidence[] @relation("ClaimEvidence_assetId")
}

model ProductMedia {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @db.Uuid
  variantId String?         @db.Uuid
  assetId   String          @db.Uuid
  kind      MediaKind
  altText   String
  position  Int             @default(0)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  product   Product         @relation("ProductMedia_productId", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant   ProductVariant? @relation("ProductMedia_variantId", fields: [variantId, productId], references: [id, productId], onDelete: Restrict, onUpdate: NoAction)
  asset     MediaAsset      @relation("ProductMedia_assetId", fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([productId, position])
  @@index([variantId])
}

model ProductRelation {
  sourceProductId String              @db.Uuid
  targetProductId String              @db.Uuid
  kind            ProductRelationKind
  position        Int                 @default(0)
  sourceProduct   Product             @relation("ProductRelation_sourceProductId", fields: [sourceProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetProduct   Product             @relation("ProductRelation_targetProductId", fields: [targetProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([sourceProductId, targetProductId, kind])
  @@index([targetProductId])
}

model Bundle {
  id                     String            @id @default(uuid()) @db.Uuid
  code                   String            @unique
  slug                   String            @unique
  name                   String
  description            String?
  priceCents             BigInt
  compositionVersion     Int               @default(1)
  imageAssetId           String?           @db.Uuid
  featuredPosition       Int?
  deletedAt              DateTime?         @db.Timestamptz(3)
  createdAt              DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(3)
  imageAsset             MediaAsset?       @relation("Bundle_imageAssetId", fields: [imageAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bundleComponent_bundle BundleComponent[] @relation("BundleComponent_bundleId")
  cartItem_bundle        CartItem[]        @relation("CartItem_bundleId")
  orderLine_bundle       OrderLine[]       @relation("OrderLine_bundleId")
}

model BundleComponent {
  bundleId  String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  bundle    Bundle         @relation("BundleComponent_bundleId", fields: [bundleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant   ProductVariant @relation("BundleComponent_variantId", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([bundleId, variantId])
  @@index([variantId])
}

model Warehouse {
  id                     String         @id @default(uuid()) @db.Uuid
  singletonKey           Int            @unique @default(1)
  name                   String
  recipientName          String
  phone                  String
  countryCode            String         @default("MX") @db.Char(2)
  postalCode             String         @db.VarChar(5)
  state                  String
  city                   String
  district               String
  street                 String
  exteriorNumber         String
  interiorNumber         String?
  references             String?
  contactName            String
  timezone               String         @default("America/Mexico_City")
  configurationVersion   Int            @default(1)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)
  inventoryLot_warehouse InventoryLot[] @relation("InventoryLot_warehouseId")
  orderPackage_warehouse OrderPackage[] @relation("OrderPackage_warehouseId")
}

model PackageType {
  id                       String         @id @default(uuid()) @db.Uuid
  code                     String         @unique
  innerLengthMm            Int
  innerWidthMm             Int
  innerHeightMm            Int
  outerLengthMm            Int
  outerWidthMm             Int
  outerHeightMm            Int
  tareWeightGrams          Int
  maxGrossWeightGrams      Int?
  isActive                 Boolean        @default(true)
  version                  Int            @default(1)
  createdAt                DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @db.Timestamptz(3)
  orderPackage_packageType OrderPackage[] @relation("OrderPackage_packageTypeId")
}

model InventoryLot {
  id                    String              @id @default(uuid()) @db.Uuid
  variantId             String              @db.Uuid
  warehouseId           String              @db.Uuid
  lotCode               String
  expiresOn             DateTime?           @db.Date
  expiryPrecision       ExpiryPrecision?
  importedOn            DateTime?           @db.Date
  customsEntry          String?
  origin                String?
  certificateAssetId    String?             @db.Uuid
  onHandQty             Int                 @default(0)
  reservedQty           Int                 @default(0)
  nonSellableQty        Int                 @default(0)
  isBlocked             Boolean             @default(false)
  version               Int                 @default(1)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)
  variant               ProductVariant      @relation("InventoryLot_variantId", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse             Warehouse           @relation("InventoryLot_warehouseId", fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  certificateAsset      MediaAsset?         @relation("InventoryLot_certificateAssetId", fields: [certificateAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  inventoryMovement_lot InventoryMovement[] @relation("InventoryMovement_lotId")
  orderUnit_lot         OrderUnit[]         @relation("OrderUnit_lotId")
  reservationStock_lot  ReservationStock[]  @relation("ReservationStock_lotId")

  @@unique([variantId, warehouseId, lotCode])
  @@unique([id, variantId])
  @@index([variantId, warehouseId, isBlocked, expiresOn, id])
}

model InventoryMovement {
  id                 String                @id @default(uuid()) @db.Uuid
  lotId              String                @db.Uuid
  kind               InventoryMovementKind
  onHandDelta        Int                   @default(0)
  reservedDelta      Int                   @default(0)
  nonSellableDelta   Int                   @default(0)
  reason             String
  actorId            String?               @db.Uuid
  actorType          ActorType
  reservationStockId String?               @db.Uuid
  orderUnitId        String?               @db.Uuid
  returnInspectionId String?               @db.Uuid
  idempotencyKey     String                @unique
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  lot                InventoryLot          @relation("InventoryMovement_lotId", fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor              User?                 @relation("InventoryMovement_actorId", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservationStock   ReservationStock?     @relation("InventoryMovement_reservationStockId", fields: [reservationStockId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderUnit          OrderUnit?            @relation("InventoryMovement_orderUnitId", fields: [orderUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  returnInspection   ReturnInspection?     @relation("InventoryMovement_returnInspectionId", fields: [returnInspectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([lotId, createdAt, id])
}

model Cart {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String?         @db.Uuid
  guestTokenHash     String?         @unique
  status             CartStatus      @default(ACTIVE)
  version            Int             @default(1)
  selectedCouponId   String?         @db.Uuid
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  user               User?           @relation("Cart_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selectedCoupon     Coupon?         @relation("Cart_selectedCouponId", fields: [selectedCouponId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cartItem_cart      CartItem[]      @relation("CartItem_cartId")
  shippingQuote_cart ShippingQuote[] @relation("ShippingQuote_cartId")
  order_sourceCart   Order[]         @relation("Order_sourceCartId")

  @@index([userId, status])
}

model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  cartId    String          @db.Uuid
  variantId String?         @db.Uuid
  bundleId  String?         @db.Uuid
  quantity  Int
  state     CartItemState   @default(ACTIVE)
  position  Int             @default(0)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  cart      Cart            @relation("CartItem_cartId", fields: [cartId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant   ProductVariant? @relation("CartItem_variantId", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
