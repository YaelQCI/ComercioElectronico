  inspectedBy                        User                @relation("ReturnInspection_inspectedById", fields: [inspectedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model PriceMatchRequest {
  id                               String           @id @default(uuid()) @db.Uuid
  orderId                          String           @db.Uuid
  requestedByUserId                String?          @db.Uuid
  guestProofId                     String?          @db.Uuid
  status                           PriceMatchStatus @default(REQUESTED)
  requestedAt                      DateTime         @default(now()) @db.Timestamptz(3)
  reviewedById                     String?          @db.Uuid
  reviewedAt                       DateTime?        @db.Timestamptz(3)
  decisionReason                   String?
  comparisonSnapshot               Json
