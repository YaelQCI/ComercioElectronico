  refund                Refund               @relation("RefundAllocation_refundId", fields: [refundId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  order                 Order                @relation("RefundAllocation_orderId", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderUnit             OrderUnit?           @relation("RefundAllocation_orderUnitId", fields: [orderUnitId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)

  @@index([orderUnitId])
  @@index([refundId])
}

model ReturnRequest {
  id                          String          @id @default(uuid()) @db.Uuid
  orderId                     String          @db.Uuid
  requestedByUserId           String?         @db.Uuid
  guestProofId                String?         @db.Uuid
  reasonCode                  ReturnReason
  description                 String
  status                      ReturnStatus    @default(REQUESTED)
  requestedAt                 DateTime        @default(now()) @db.Timestamptz(3)
  reviewedById                String?         @db.Uuid
  reviewedAt                  DateTime?       @db.Timestamptz(3)
  decisionReason              String?
  receivedAt                  DateTime?       @db.Timestamptz(3)
  resolvedAt                  DateTime?       @db.Timestamptz(3)
  storeFault                  Boolean         @default(false)
  returnCostPayer             ReturnCostPayer
  returnCostCents             BigInt?
  returnLogisticsNote         String?
  createdAt                   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime        @updatedAt @db.Timestamptz(3)
  refund_returnRequest        Refund[]        @relation("Refund_returnRequestId")
  order                       Order           @relation("ReturnRequest_orderId", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedByUser             User?           @relation("ReturnRequest_requestedByUserId", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  guestProof                  ActionToken?    @relation("ReturnRequest_guestProofId", fields: [guestProofId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  reviewedBy                  User?           @relation("ReturnRequest_reviewedById", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  returnItem_returnRequest    ReturnItem[]    @relation("ReturnItem_returnRequestId")
  claimEvidence_returnRequest ClaimEvidence[] @relation("ClaimEvidence_returnRequestId")

  @@unique([id, orderId])
  @@index([orderId, requestedAt])
}

model ReturnItem {
  id                          String            @id @default(uuid()) @db.Uuid
  returnRequestId             String            @db.Uuid
  orderId                     String            @db.Uuid
  orderUnitId                 String            @db.Uuid
  state                       ReturnItemState   @default(REQUESTED)
  reportedCondition           ProductCondition?
  createdAt                   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime          @updatedAt @db.Timestamptz(3)
  returnRequest               ReturnRequest     @relation("ReturnItem_returnRequestId", fields: [returnRequestId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  order                       Order             @relation("ReturnItem_orderId", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderUnit                   OrderUnit         @relation("ReturnItem_orderUnitId", fields: [orderUnitId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: NoAction)
  returnInspection_returnItem ReturnInspection? @relation("ReturnInspection_returnItemId")

  @@unique([returnRequestId, orderUnitId])
  @@index([orderUnitId])
}

model ReturnInspection {
  id                                 String              @id @default(uuid()) @db.Uuid
  returnItemId                       String              @unique @db.Uuid
  inspectedById                      String              @db.Uuid
