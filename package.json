{
  "name": "the-fitness-stuff",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "restock:observe": "node scripts/observe-restock.mjs",
    "test:pricing": "node --test tests/pricing/*.test.mjs",
    "catalog:import": "node scripts/import-catalog.mjs",
    "test:catalog": "node --test tests/catalog/*.test.mjs",
    "test:database": "node --test --test-concurrency=1 tests/database/*.test.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "prisma generate && nuxt prepare",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node --env-file=.env scripts/check-database.mjs",
    "db:migration:create": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "nuxt": "4.5.2",
    "pg": "8.23.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "dotenv": "18.0.7",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3"
  }
}
